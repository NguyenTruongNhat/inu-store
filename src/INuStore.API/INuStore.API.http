@INuStore.API_HostAddress = https://localhost:7005
@apiVersion = 1
@userId = 8
@pageIndex = 1
@pageSize = 10
@accessToken = replace-with-access-token
@roleId = 6

### Liveness: API is responding without checking SQL Server
GET {{INuStore.API_HostAddress}}/health/live
Accept: text/plain

### Readiness: API can connect to SQL Server
GET {{INuStore.API_HostAddress}}/health/ready
Accept: text/plain

### Get all users
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/GetAllUsers?PageIndex={{pageIndex}}&PageSize={{pageSize}}
Accept: application/json

### Get a user by ID (replace userId above with an existing user's ID)
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/GetUserById?UserId={{userId}}
Accept: application/json

### Create a user
POST {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/CreateUser
Content-Type: application/json

{
  "userName": "testuser",
  "email": "testuser@example.com",
  "password": "TestPassword123!"
}

### Update a user
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/UpdateUser
Content-Type: application/json

{
  "userId": "{{userId}}",
  "userName": "updateduser",
  "email": "updateduser@example.com"
}

### Delete a user
DELETE {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/DeleteUser
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### Get roles assigned to a user
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles
Authorization: Bearer {{accessToken}}
Accept: application/json

### Replace all roles (use existing IDs; repeat this request to verify idempotency)
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [1, 3, 4] }

### Duplicate IDs are normalized: same role set as above
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [1, 3, 3, 4] }

### Empty list: HTTP 400 when SQL Server is available
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [] }

### Null list: HTTP 400 when SQL Server is available
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": null }

### Invalid role IDs: HTTP 400 when SQL Server is available
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [0, -1] }

### Invalid user ID: HTTP 400 via FluentValidation when SQL Server is available
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/0/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [1] }

### Negative user ID: HTTP 400 via FluentValidation when SQL Server is available
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/-1/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [1] }

### Missing user: HTTP 404 (choose an ID absent from the database)
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/2147483647/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [1] }

### Missing role: HTTP 404; no assignments are changed
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "roleIds": [1, 2147483647] }

### Assign a role (repeat to verify success without a duplicate assignment)
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Remove a role assignment (repeat to verify success when already removed)
DELETE {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Invalid assignment user ID: HTTP 400 when SQL Server is available
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/0/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Invalid assignment role ID: HTTP 400 when SQL Server is available
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles/-1
Authorization: Bearer {{accessToken}}

### Invalid removal user ID: HTTP 400 when SQL Server is available
DELETE {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/-1/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Invalid removal role ID: HTTP 400 when SQL Server is available
DELETE {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/User/{{userId}}/roles/0
Authorization: Bearer {{accessToken}}

### Get all roles (log in and set accessToken above)
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/GetAllRoles
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get a role by ID (set roleId to an existing custom role)
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/GetRoleById?RoleId={{roleId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create a custom role (repeat to verify HTTP 400 for a duplicate name)
POST {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/CreateRole
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Support",
  "description": "Handles customer support requests."
}

### Update a custom role
PUT {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/UpdateRole
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roleId": {{roleId}},
  "name": "CustomerSupport",
  "description": "Handles customer support and order questions."
}

### Delete an unassigned custom role
DELETE {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/DeleteRole
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "roleId": {{roleId}}
}

### Missing role: HTTP 404
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/GetRoleById?RoleId=2147483647
Authorization: Bearer {{accessToken}}

### Invalid role ID: HTTP 400
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/GetRoleById?RoleId=0
Authorization: Bearer {{accessToken}}

### Missing access token: HTTP 401
GET {{INuStore.API_HostAddress}}/api/v{{apiVersion}}/Role/GetAllRoles
